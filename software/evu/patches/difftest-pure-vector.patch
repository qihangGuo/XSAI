   const size_t ame_replay_state_size = proxy->ame_replay_state_size();
   ame_replay_state_ss.resize(ame_replay_state_size);
   if (!ame_replay_state_ss.empty()) {
@@ -751,6 +764,11 @@ inline int Difftest::check_all() {
     return ret;
